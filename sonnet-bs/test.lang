val fib = fun fib (n) ->
	if n < 2 then n
	else fib( n-1) + fib(n-2);

val fib2 = fun (n) -> {
	if n < 2 then {
		return n;
	};

	var a = 0;
	var b = 0;
	var i = 2;

	while i <= n do {
		var temp = a + b;
		a = b;
		b = temp;
		i = i + 1;
	};

	b
};

val t = fun (a) -> {
	var b = @t2(a); 
	var c = @neg(a);
	c
};