val print_i32 : (i32) -> struct{}

# constants
val x = 1;
val y = 2;

###
multiline comment ##
do extend until the next matching sequence
###

val a; # declares a without type nor init

val b : i32; #declares b only with its type

val id = fun (x) -> x;

val add = fun(a, b)-> a + b;
val t = fun (a, b) -> add(a, b); # declaration wiht init

val r : i32 = 0; # declaration with type and init

val prec_test = 1 * 2 + 3 * 4 as i32 / 2;

type int = i32;

val main = fun () -> {
	val a : i32 = 3;
	val b : i32 = 10;
	print_i32(a + b);

	val ptr : *i32 = &a;
	print_i32(ptr.*);
	return 0;
};
